# Copy thành .env (KHÔNG commit file .env)

# Supabase — pipeline dùng service role key (chỉ chạy ở server / GitHub Actions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — web app (anon key, an toàn ở client nhờ RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
FOOTBALL_DATA_TOKEN=
# Trần chi phí AI mỗi ngày (USD) — chỉ dùng khi chưa có bảng settings; bình thường chỉnh ở trang Cài đặt
DAILY_BUDGET_USD=
# Đổi model nếu cần (mặc định: claude-haiku-5-5 để phân loại, claude-opus-5-5 để viết)
CLASSIFY_MODEL=
WRITE_MODEL=
